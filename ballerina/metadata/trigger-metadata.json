{
  "version": "v1.0",
  "listeners": [
    {
      "id": "$listener",
      "doc": "Webhook listener that dispatches each inbound HubSpot CRM webhook event to the concrete service type matching its object.",
      "type": {
        "name": "Listener"
      },
      "services": [
        "$ticket",
        "$company",
        "$lineItem",
        "$product",
        "$conversation",
        "$deal",
        "$contact"
      ],
      "multipleServicesAllowed": true,
      "multipleServicesOfSameTypeAllowed": false
    }
  ],
  "serviceTypes": [
